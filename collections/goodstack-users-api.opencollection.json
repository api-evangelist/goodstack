{
  "opencollection": "1.0.0",
  "info": {
    "name": "Goodstack Services Activities Users API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goodstack.io/v1/users",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Create a User"
        },
        {
          "info": {
            "name": "Retrieve a User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodstack.io/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of the user"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a User"
        },
        {
          "info": {
            "name": "Set User to support an Organisation",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.goodstack.io/v1/users/:id/organisation",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of the User."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "For Donations created through the [Create A Donation API](./create-a-donation), A User can be set to donate to a particular Organisation by default using this API. If a Donation is made with a userId, the Donation will be associated with the Organisation the User is supporting at the time of Donation. If the userId is omitted or the User has not been set to donate to an Organisation by default then the organisationId must be included in the body.\n"
        }
      ]
    }
  ],
  "bundled": true
}