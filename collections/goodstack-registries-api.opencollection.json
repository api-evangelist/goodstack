{
  "opencollection": "1.0.0",
  "info": {
    "name": "Goodstack Services Activities Registries API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Registries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Registries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodstack.io/v1/registries",
            "params": [
              {
                "name": "countryCode",
                "value": "",
                "type": "query",
                "description": "3 letter ISO-3166 alpha 3 identifier of the country"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List Registries"
        },
        {
          "info": {
            "name": "Retrieve a Registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodstack.io/v1/registries/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of the registry"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a Registry"
        }
      ]
    }
  ],
  "bundled": true
}