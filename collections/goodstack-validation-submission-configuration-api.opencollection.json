{
  "opencollection": "1.0.0",
  "info": {
    "name": "Goodstack Services Activities Validation Submission Configuration API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Validation Submission Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve partner's configurations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodstack.io/v1/validation-submission-configurations",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve partner's configurations"
        },
        {
          "info": {
            "name": "Retrieve specific configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodstack.io/v1/validation-submission-configurations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of the validation submission configuration"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve specific configuration"
        }
      ]
    }
  ],
  "bundled": true
}